# AddressSanitizer runtime suppressions for MiNiFi C++ ASan builds (MINIFI_ADVANCED_ASAN_BUILD=ON).
# Referenced from cmake/BuildTests.cmake via ASAN_OPTIONS=suppressions=... for every unit test.

# Defined identically in two different .so's, not a problem.
odr_violation:minifi_api_version
odr_violation:runningAsService_

# Defined identically in two different .so's, coming from third-party dependencies, not a problem.
odr_violation:BZ2_crc32Table
odr_violation:deflate_copyright
odr_violation:inflate_copyright
odr_violation:m_amount
odr_violation:RFC1123_no_wday
